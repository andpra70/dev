# Copiare questo file in .env e sostituire tutte le password di esempio.
VSCODE_PASSWORD=change-me-vscode

# GitLab CE
GITLAB_VERSION=latest
GITLAB_HOSTNAME=gitlab.local
GITLAB_EXTERNAL_URL=http://127.0.0.1:8929
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
GITLAB_ROOT_EMAIL=root@local.invalid
GITLAB_ROOT_PASSWORD=change-me-gitlab

# PostgreSQL
POSTGRES_VERSION=17-alpine
POSTGRES_HOST_PORT=15432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres

# Redis
REDIS_VERSION=7.4-alpine
REDIS_HOST_PORT=16379
REDIS_PASSWORD=change-me-redis

# MongoDB
MONGO_VERSION=8.0
MONGO_HOST_PORT=27018
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongodb
MONGO_DATABASE=app
