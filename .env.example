# Copiare questo file in .env e sostituire tutte le password di esempio.
VSCODE_PASSWORD=change-me-vscode

# Gitea rootless con SQLite
GITEA_VERSION=latest-rootless
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2225
GITEA_DOMAIN=gitea
GITEA_ROOT_URL=http://gitea:3000/

# Gitea Actions Runner. Creare il token dall'amministrazione di Gitea.
GITEA_RUNNER_VERSION=3
GITEA_RUNNER_URL=http://gitea:3000
GITEA_RUNNER_TOKEN=replace-with-gitea-registration-token
GITEA_RUNNER_NAME=isolated-gitea-runner
GITEA_RUNNER_LABELS=ubuntu-latest:docker://node:22-bookworm,ubuntu-22.04:docker://node:22-bookworm

# Dockge con daemon Docker-in-Docker isolato
DOCKGE_VERSION=1
DOCKGE_DOCKER_VERSION=27
DOCKGE_HTTP_PORT=5001
DOCKGE_APP_PORT_START=18000
DOCKGE_APP_PORT_END=18099

# Vikunja con SQLite
VIKUNJA_VERSION=2.6.0
VIKUNJA_HTTP_PORT=3456
VIKUNJA_PUBLIC_URL=http://localhost:3456/
VIKUNJA_TOKEN=tk_2c0a0817d2a0636b1261e11fc26f601223ce8c10

# PostgreSQL
POSTGRES_VERSION=17-alpine
POSTGRES_HOST_PORT=15432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres

# Redis
REDIS_VERSION=7.4-alpine
REDIS_HOST_PORT=16379
REDIS_PASSWORD=change-me-redis

# MongoDB
MONGO_VERSION=8.0
MONGO_HOST_PORT=27018
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongodb
MONGO_DATABASE=app
